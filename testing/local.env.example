# Copy to testing/local.env (gitignored). Non-secret settings only.
# Do not put tokens, passwords, or API keys in this file.

# Templates, the codex mirror, and the claude-plugins-official mirror. On a Mac, put this under your home so Docker can mount it.
# Unset default is /workspace/agents (Linux bubblewrap).
# SKILLMAXX_AGENTS=$HOME/skillmaxx-agents

# Used only when bwrap is missing. See testing/mac_nightly.sh steps for the one-time build.
# SKILLMAXX_SANDBOX_IMAGE=skillmaxx-sandbox:local

# mac_nightly.sh run stays on the current branch and does not push.
# Set both of the next lines only after a trial log reaches done and the Grok routine is paused.
# Together they make nightly.sh checkout master and push. Either one alone stays in trial.
# Direct testing/nightly.sh is unchanged: it checks out master unless SKILLMAXX_TRIAL=1.
# SKILLMAXX_PRODUCTION=yes
# SKILLMAXX_ALLOW_PUSH=yes
