# Copy to testing/local.env (gitignored). Non-secret settings only.
# Do not put tokens, passwords, or API keys in this file.

# Templates and the codex mirror. On a Mac, put this under your home so Docker can mount it.
# Unset default is /workspace/agents (Linux bubblewrap).
# SKILLMAXX_AGENTS=$HOME/skillmaxx-agents

# Used only when bwrap is missing. See testing/mac_nightly.sh steps for the one-time build.
# SKILLMAXX_SANDBOX_IMAGE=skillmaxx-sandbox:local

# testing/mac_nightly.sh run does not git push unless this is exactly yes.
# testing/nightly.sh itself is unchanged: it pushes unless NOPUSH is already set.
# Leave this unset until the Grok 2 AM routine is paused and a NOPUSH trial looks right.
# SKILLMAXX_ALLOW_PUSH=yes
