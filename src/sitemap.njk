---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?><urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">{% for p in collections.all %}{% if not p.url.startsWith("/skills/") and not p.data.noindex and p.url.endsWith("/") %}<url><loc>{{ site.url }}{{ p.url }}</loc><lastmod>{{ (p.data.issueDate or site.checked) | day }}</lastmod></url>{% endif %}{% endfor %}{% for s in skills %}<url><loc>{{ site.url }}/skills/{{ s.slug }}/</loc><lastmod>{{ (s.test.claude_code.at or site.checked) | day }}</lastmod></url>{% endfor %}</urlset>
