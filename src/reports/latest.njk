{% set jsonld2 = {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How do I know if an agent skill or MCP server is safe to install today?","acceptedAnswer":{"@type":"Answer","text":"Search it on this page. SkillMaxx installs every listed add-on nightly in Claude Code, Codex, Grok Build, Cursor and Pi in a clean sandbox. On " + r.date + ", " + r.pass + " of " + r.total + " installs passed."} },{"@type":"Question","name":"What does 'needs your API key' mean?","acceptedAnswer":{"@type":"Answer","text":"The install only failed because the add-on asked for an API key or token, and our sandbox has none on purpose. It usually works once you add your own key."} },{"@type":"Question","name":"When does SkillMaxx call an add-on broken?","acceptedAnswer":{"@type":"Answer","text":"Only after it fails two nights in a row. Each failed install is retried once, a single bad night is marked pending, and add-ons that flip-flop are marked flaky."} }]} %}
