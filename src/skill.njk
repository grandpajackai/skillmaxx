---
layout: base.njk
pagination: {data: skills, size: 1, alias: s}
permalink: "/skills/{{ s.slug }}/"
eleventyComputed:
  title: "{{ s.name }}: install for Claude Code, Codex, Grok Build, Cursor & Pi"
  desc: "{{ s.description | truncate(150) }}"
  jsonld: {"@context":"https://schema.org","@type":"SoftwareApplication","name":"{{ s.name }}","description":"{{ s.description | truncate(150) }}","applicationCategory":"DeveloperApplication","url":"{{ s.source_url }}","operatingSystem":"Cross-platform"}
---
{% from "badge.njk" import badge %}
<p class="crumbs"><a href="/">All skills</a> / {{ s.category }}</p>
<h1>{{ s.name }}</h1><p class="lead">{{ s.description }}</p>
<p class="meta"><span class="tag">{{ s.category }}</span> <span class="tag">{{ s.type }}</span> <a href="{{ s.source_url }}" rel="nofollow noopener">Source ↗</a> · {% for l in s.listings %}<a href="{{ l }}" rel="nofollow noopener">Listing ↗</a> {% endfor %}</p>
<h2>Install by agent</h2><div class="installs">{% for a in site.agents %}<div class="inst"><div class="ih"><b>{{ a|agentName }}</b><span>{{ badge(s.compatibility[a]) }}{% if s.compat_sources[a] %} <a class="src" href="{{ s.compat_sources[a] }}" rel="nofollow noopener">source ↗</a>{% endif %}</span></div>
{% if s.install[a] %}<div class="code"><code>{{ s.install[a] }}</code><button onclick="navigator.clipboard.writeText(this.previousElementSibling.textContent);this.textContent='Copied'">Copy</button></div>{% else %}<p class="muted">No official install instructions found yet.</p>{% endif %}</div>{% endfor %}</div>
{% if s.notes %}<p class="note">{{ s.notes }}</p>{% endif %}
<p class="muted">"Documented" means an official source publishes the install method. SkillMaxx has not tested it.</p>
