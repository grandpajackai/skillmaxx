---
layout: base.njk
title: "Compatibility matrix: agent skills across 5 coding agents"
desc: "Which skills, plugins and MCP servers have install methods verified from official docs for Claude Code, Codex, Grok Build, Cursor and Pi."
---
{% from "macros.njk" import status %}
<div class="wrap"><h1 class="ph">Compatibility matrix</h1><p class="lead">{{ skills.length }} skills × 5 agents, checked against official docs on {{ site.checked }}. No hands-on install tests yet.</p>
<div class="mbar"><input id="mq" type="search" placeholder="Filter skills…" aria-label="Filter matrix"><label><input type="checkbox" id="hideu"> Hide skills not yet verified for my agent</label><label><input type="checkbox" id="all5"> Verified in all 5 only</label><span class="muted" id="mn"></span></div>
<div class="tw"><table class="matrix"><thead><tr><th>Skill</th>{% for a in site.agents %}<th data-a="{{ a }}"><i class="ad" style="--c:{{ site.agentColor[a] }}"></i>{{ a|agentName }}</th>{% endfor %}</tr></thead><tbody>
{% for s in skills %}<tr data-text="{{ s.name|lower }} {{ s.category }}" data-docs="{{ s.docs|join(' ') }}" data-n="{{ s.docCount }}"><th scope="row"><a href="/skills/{{ s.slug }}/">{{ s.name }}</a><small>{{ s.category }}</small></th>{% for a in site.agents %}<td data-label="{{ a|agentName }}" data-a="{{ a }}"><span class="cell {{ s.compatibility[a] }}" title="{{ a|agentName }}: {{ s.compatibility[a]|statusLabel }}">{% if s.compatibility[a]=='documented' %}✓ Docs{% else %}–{% endif %}</span></td>{% endfor %}</tr>{% endfor %}
</tbody></table></div></div>
