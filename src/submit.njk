---
layout: base.njk
title: "Submit an agent skill, plugin or MCP server"
desc: "Submit your skill, plugin or MCP server to SkillMaxx — free listing on the skills directory across 5 coding agents."
---
<div class="wrap prose">
  <h1 class="ph">Submit a skill</h1>
  <p class="lead">List a skill, plugin or MCP server for free. We check the source and, where we can, sandbox-test the install.</p>
  <p class="muted" id="intake-note">{{ intake.note }}</p>

  <div class="card static" id="form-card">
    <form id="submit-form" class="intake" method="post" action="" data-kind="skill" data-endpoint="{{ intake.endpoint }}" data-err="#submit-err" data-ok="#submit-ok" novalidate>
      <div class="fg">
        <label class="fl" for="skill-name">
          <span>Skill name <em>Required</em></span>
          <input id="skill-name" name="name" required maxlength="120" autocomplete="off" placeholder="e.g. Postgres MCP">
        </label>
        <label class="fl" for="skill-url">
          <span>Source URL <em>Required</em></span>
          <input id="skill-url" name="source_url" type="url" inputmode="url" required maxlength="400" placeholder="https://github.com/you/your-skill" autocomplete="url">
        </label>
      </div>

      <details class="opt">
        <summary>Optional details</summary>
        <div class="fg">
          <label class="fl" for="skill-email">
            <span>Your email <em>Optional, only if you want a reply</em></span>
            <input id="skill-email" name="email" type="email" inputmode="email" maxlength="200" autocomplete="email" placeholder="you@example.com">
          </label>
          <label class="fl" for="skill-desc">
            <span>One-line description</span>
            <input id="skill-desc" name="description" maxlength="200" placeholder="What it does, in one sentence">
          </label>
          <label class="fl" for="skill-cat">
            <span>Category</span>
            <select id="skill-cat" name="category">
              <option value="">Choose a category…</option>
              <option value="automation">Automation</option>
              <option value="communication">Communication</option>
              <option value="database">Database</option>
              <option value="deployment">Deployment</option>
              <option value="design">Design</option>
              <option value="development">Development</option>
              <option value="education & research">Education &amp; Research</option>
              <option value="mcp servers">MCP Servers</option>
              <option value="monitoring">Monitoring</option>
              <option value="productivity">Productivity</option>
              <option value="security">Security</option>
              <option value="utilities">Utilities</option>
              <option value="other">Other</option>
            </select>
          </label>
          <p class="hint">Install-doc links earn “Verified from docs”. Leave blank for agents you don't support.</p>
          <label class="fl" for="doc-claude"><span class="alabel"><i class="ad" style="--c:{{ site.agentColor.claude_code }}"></i>Claude Code docs</span><input id="doc-claude" type="url" inputmode="url" name="install_claude_code" maxlength="400" placeholder="https://"></label>
          <label class="fl" for="doc-codex"><span class="alabel"><i class="ad" style="--c:{{ site.agentColor.codex }}"></i>Codex docs</span><input id="doc-codex" type="url" inputmode="url" name="install_codex" maxlength="400" placeholder="https://"></label>
          <label class="fl" for="doc-grok"><span class="alabel"><i class="ad" style="--c:{{ site.agentColor.grok_build }}"></i>Grok Build docs</span><input id="doc-grok" type="url" inputmode="url" name="install_grok_build" maxlength="400" placeholder="https://"></label>
          <label class="fl" for="doc-cursor"><span class="alabel"><i class="ad" style="--c:{{ site.agentColor.cursor }}"></i>Cursor docs</span><input id="doc-cursor" type="url" inputmode="url" name="install_cursor" maxlength="400" placeholder="https://"></label>
          <label class="fl" for="doc-pi"><span class="alabel"><i class="ad" style="--c:{{ site.agentColor.pi }}"></i>Pi docs</span><input id="doc-pi" type="url" inputmode="url" name="install_pi" maxlength="400" placeholder="https://"></label>
        </div>
      </details>

      <p class="sr" aria-hidden="true"><label>Leave blank<input name="fax_number" tabindex="-1" autocomplete="off"></label></p>

      <div class="form-actions">
        <button type="submit" class="btn">{{ intake.skillButton }}</button>
        <p class="hint">{{ intake.help }}</p>
      </div>
    </form>
    <div id="submit-ok" class="form-status" role="status" tabindex="-1"></div>
    <p id="submit-err" class="form-err" role="alert" tabindex="-1"></p>
    <noscript><p>Script is off, so this page can't copy or submit. Email skillmaxx@gilventures.ai the skill name and source link.</p></noscript>
  </div>
</div>
<script src="/assets/forms.js" type="module"></script>
